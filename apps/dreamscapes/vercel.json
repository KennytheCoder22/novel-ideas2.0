{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build.mjs",
  "installCommand": "echo No dependencies required",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "codex/dreamscapes-autonomous-playtesting": false,
      "codex/dreamscapes-autonomous-cycle-one": false,
      "codex/dreamscapes-observation-foundation": false,
      "codex/dreamscapes-interactive-carousel": false,
      "codex/dreamscapes-first-person-ride": false
    }
  },
  "headers": [
    {
      "source": "/carnival/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/experiments/carnival/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/carnival",
      "destination": "/carnival/",
      "permanent": true
    },
    {
      "source": "/carnival/index.html",
      "destination": "/carnival/",
      "permanent": true
    },
    {
      "source": "/experiments/carnival",
      "destination": "/carnival/",
      "permanent": true
    },
    {
      "source": "/experiments/carnival/",
      "destination": "/carnival/",
      "permanent": true
    },
    {
      "source": "/experiments/carnival/index.html",
      "destination": "/carnival/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/carnival/",
      "destination": "/experiments/carnival/index.html"
    },
    {
      "source": "/carnival/:path*",
      "destination": "/experiments/carnival/:path*"
    }
  ]
}
