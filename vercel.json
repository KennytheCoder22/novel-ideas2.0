{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/y",
      "destination": "/yvhs",
      "permanent": true
    },
    {
      "source": "/c/y",
      "destination": "/yvhs",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/testing",
      "destination": "/"
    },
    {
      "source": "/testing/:path*",
      "destination": "/"
    },
    {
      "source": "/how-it-works",
      "destination": "/"
    },
    {
      "source": "/feedback",
      "destination": "/"
    },
    {
      "source": "/privacy",
      "destination": "/"
    },
    {
      "source": "/about",
      "destination": "/"
    },
    {
      "source": "/app_admin-web",
      "destination": "/"
    },
    {
      "source": "/app_admin-web/:path*",
      "destination": "/"
    },
    {
      "source": "/c/:path*",
      "destination": "/"
    },
    {
      "source": "/admin/:path*",
      "destination": "/"
    },
    {
      "source": "/admin-collection",
      "destination": "/"
    },
    {
      "source": "/swipe",
      "destination": "/"
    },
    {
      "source": "/:libraryId([A-Za-z0-9_-]+)",
      "destination": "/"
    }
  ]
}
